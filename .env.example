# DeepSeek API 配置
RAG_LLM_API_KEY=sk-your-deepseek-api-key-here
RAG_LLM_BASE_URL=https://api.deepseek.com/v1
RAG_LLM_MODEL=deepseek-chat


# ============ 可选 ============
# 业务默认值以 src/rag/config.py 为准
# 需要覆盖时，取消注释并改值（不推荐，除非有特殊场景）
#
# RAG_TOP_K=1
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5


# 启用 QueryRewrite（v2）
# RAG_QUERY_REWRITE_ENABLED=true